# Copy these values into the AppSail service's environment-variable settings.
# Do not commit a real .env file.
FRONTEND_ORIGINS=https://your-slate-app.example.com

# PostgreSQL database used by the intelligence gateway.
DB_HOST=your-postgres-host
DB_PORT=5432
DB_NAME=ksp_db
DB_USER=ksp_user
DB_PASSWORD=replace-with-a-secret

# Set one provider and only its relevant credential.
LLM_PROVIDER=catalyst
CATALYST_API_KEY=replace-with-a-secret
CATALYST_ORG=your-catalyst-org-id
CATALYST_PROJECT_ID=your-catalyst-project-id

# Alternatives: groq, openai, or anthropic.
# GROQ_API_KEY=replace-with-a-secret
# OPENAI_API_KEY=replace-with-a-secret
# ANTHROPIC_API_KEY=replace-with-a-secret
