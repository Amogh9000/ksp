# Database
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=local_secure_password
DB_NAME=rag_database

# SQLAlchemy
DATABASE_URL=postgresql+asyncpg://postgres:local_secure_password@127.0.0.1:5433/rag_database
SYNC_DATABASE_URL=postgresql://postgres:local_secure_password@127.0.0.1:5433/rag_database

# LLM 
USE_TF=0
USE_TORCH=1
KMP_DUPLICATE_LIB_OK=True
TF_CPP_MIN_LOG_LEVEL=2

SECRET_KEY=change-this-to-a-random-256-bit-secret
LLM_PROVIDER=catalyst
CATALYST_API_KEY=<access-token>
