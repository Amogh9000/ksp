# PostgreSQL connection
DATABASE_URL=postgresql+asyncpg://ksp_user:ksp_password@localhost:5432/ksp_db
SYNC_DATABASE_URL=postgresql://ksp_user:ksp_password@localhost:5432/ksp_db

# JWT
SECRET_KEY=change-this-to-a-random-256-bit-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# App
APP_ENV=development
APP_PORT=8000
